#!/bin/bash
# mcx-setup: first-run setup of the MetaCodex userland (Debian 13 arm64 under proot, inside the headset app).
#   mcx-setup          base tools + Node.js 24 LTS (the agents, bb and the local AI CLI all need Node >= 22)
#   mcx-setup quest    + everything to build native Quest apps here (mcx-app, skill quest-native-apps): APK tools
#                      (aapt2, zipalign, apksigner), a JDK (keytool), the Android NDK r27d, android.jar (Android SDK
#                      Platform 34), OpenXR 1.1.65 (Khronos headers + Android loader) and D8 (2D panel apps: Java -> dex).
#                      About 420 MB to download, 2.5 GB on disk.
#   mcx-setup ndk      + only the Android NDK r27d (the SYSTEM > TOOLS tile)
#   mcx-setup d8       + only D8, the dexer of 2D panel apps (R8 9.5.32 from Google Maven, 21 MB; `mcx-setup quest`
#                      installs it too, and mcx-build fetches it on the first 2D build when it is missing)
#   mcx-setup agents   + the cloud agent CLI (official installer, npm fallback) and the open agent CLI (npm)
#   mcx-setup qvac     + the local AI runtime (QVAC SDK in /root/qvac, its CLI with the local API server)
#   mcx-setup all      everything above
# The app runs `mcx-setup quest` by itself once per Linux install (log: /root/.metacodex/first-use.log).
# Safe to rerun: each step is skipped when already done; every download is checked against a pinned sha256 and
# unpacked into a temporary folder that is renamed only when complete. Shipped by the app (overlay); edits are
# overwritten.
set -euo pipefail
# Debian's /etc/profile resets root's PATH and drops ~/.local/bin, where the official installer puts the
# cloud agent CLI
export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"
want="${1:-base}"
export DEBIAN_FRONTEND=noninteractive
say() { printf '\033[1;36m==> %s\033[0m\n' "$*"; }
# low priority (the app renders on the same cores); wait for a terminal's apt instead of failing on its lock
APT=(nice -n 10 apt-get -o DPkg::Lock::Timeout=600 -y -q)
t0=$(date +%s)
# an install the app interrupted (it was closed) leaves dpkg half-configured: finish it first
nice -n 10 dpkg --configure -a >/dev/null 2>&1 || true

# fetch URL SHA256 FILE: download once, keep it only when the digest matches
fetch() {
  local url=$1 sum=$2 dest=$3
  if [ -f "$dest" ] && echo "$sum  $dest" | sha256sum -c --quiet - >/dev/null 2>&1; then return 0; fi
  rm -f "$dest.part"
  curl -fL --retry 3 --retry-delay 3 -o "$dest.part" "$url"
  if ! echo "$sum  $dest.part" | sha256sum -c --quiet -; then
    rm -f "$dest.part"; echo "mcx-setup: wrong sha256 for $url" >&2; return 1
  fi
  mv "$dest.part" "$dest"
}

# the base packages shipped in the app's userland (tools/userland-image.sh): installed from the image, offline
SHIPPED=/var/cache/metacodex/base-debs
if ls "$SHIPPED"/*.deb >/dev/null 2>&1; then
  say "base tools shipped with the app (offline): $(ls "$SHIPPED"/*.deb | wc -l) packages"
  if nice -n 10 mcx-install-debs "$SHIPPED" >/dev/null; then rm -rf "$SHIPPED"
  else echo "mcx-setup: the shipped packages did not install: apt fetches them instead" >&2; fi
fi
if ! command -v curl >/dev/null || ! command -v git >/dev/null || ! command -v xz >/dev/null || ! command -v python3 >/dev/null; then
  say "apt: base tools"
  "${APT[@]}" update
  "${APT[@]}" install --no-install-recommends ca-certificates curl git xz-utils python3 procps less nano
fi

node_major() { node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0; }
if [ "$(node_major)" -lt 22 ]; then
  say "Node.js 24 LTS (nodejs.org, linux-arm64)"
  base=https://nodejs.org/dist/latest-v24.x
  sums=$(curl -fsSL "$base/SHASUMS256.txt")
  f=$(printf '%s\n' "$sums" | grep -o 'node-v[0-9.]*-linux-arm64\.tar\.xz' | head -1)
  cd /tmp
  curl -fsSLO "$base/$f"
  printf '%s\n' "$sums" | grep " $f\$" | sha256sum -c -
  nice -n 10 tar -xJf "$f" -C /usr/local --strip-components=1 --no-same-owner
  rm -f "$f"
fi
say "node $(node -v), npm $(npm -v)"

# --- native Quest apps ------------------------------------------------------------------------------------------
# Android NDK r27d (LTS) for arm64 hosts: Google ships Linux NDKs for x86_64 only, so this is the community build
# (github.com/HomuHomu833/android-ndk-custom), pinned to its sha256 (GitHub's release digest).
NDK_URL=https://github.com/HomuHomu833/android-ndk-custom/releases/download/r27/android-ndk-r27d-aarch64-linux-gnu.tar.xz
NDK_SHA=94a7e5a0dffee4ab68cc14adc081674c6f42116046d5ae1eafe1f3492a1045dc
# android.jar: Android SDK Platform 34 (ext7 r3) from Google's SDK repository, the file sdkmanager downloads
# (sha1 1f2e9478d6a7601425ceaa553311dc43191f103d in repository2-3.xml), under the Android SDK License
PLATFORM_URL=https://dl.google.com/android/repository/platform-34-ext7_r03.zip
PLATFORM_SHA=16fdb74c55e59ae3ef52def135aec713508467bd56d7dabcd8c9be31fa8b20f3
# OpenXR: Khronos' loader for Android with the headers (prefab), Maven Central, Apache-2.0
OPENXR_VERSION=1.1.65
OPENXR_URL=https://repo1.maven.org/maven2/org/khronos/openxr/openxr_loader_for_android/$OPENXR_VERSION/openxr_loader_for_android-$OPENXR_VERSION.aar
OPENXR_SHA=a298c326085b09181c85235fb04d37510939bd30938ed4322c093c09780e8643

# D8, Google's dexer (Java classes -> classes.dex) for 2D panel apps: the R8 jar from Google Maven (com.android.tools:r8,
# BSD-3-Clause; the libraries inside it Apache-2.0, BSD, MIT: its LICENSE file, kept next to it). Class files 55: it runs
# on Java 11 and later (Debian 13's default JDK is 21) and reads the Java 17 classes mcx-build's javac writes.
R8_VERSION=9.5.32
R8_URL=https://dl.google.com/android/maven2/com/android/tools/r8/$R8_VERSION/r8-$R8_VERSION.jar
R8_SHA=7c7b67be3069d395cdfbdea4799ffd04d75d81ccecf3d01a78df37b1f5843298
install_d8() {
  local R=/opt/android-sdk/r8
  if [ -f $R/r8.jar ] && [ -f $R/LICENSE ] && [ "$(cat $R/VERSION 2>/dev/null)" = "$R8_VERSION" ]; then return 0; fi
  if ! command -v javac >/dev/null; then
    say "apt: a JDK (javac, for 2D panel apps)"
    "${APT[@]}" update
    "${APT[@]}" install --no-install-recommends default-jdk-headless
  fi
  say "D8 $R8_VERSION (Google's dexer for 2D panel apps: 21 MB from Google Maven, BSD-3-Clause)"
  fetch "$R8_URL" "$R8_SHA" /tmp/r8-$R8_VERSION.jar
  rm -rf $R.part && mkdir -p $R.part
  mv /tmp/r8-$R8_VERSION.jar $R.part/r8.jar
  # its licence file (R8 and the libraries in it); python, not unzip: `mcx-setup d8` alone may run before unzip is there
  python3 -I -c 'import sys, zipfile; zipfile.ZipFile(sys.argv[1]).extract("LICENSE", sys.argv[2])' $R.part/r8.jar $R.part
  echo "$R8_VERSION" > $R.part/VERSION
  rm -rf $R && mv $R.part $R
}

install_ndk() {
  if [ -x /opt/android-ndk/toolchains/llvm/prebuilt/linux-arm64/bin/clang++ ]; then return 0; fi
  say "Android NDK r27d (arm64 build, 115 MB download, 1.3 GB unpacked)"
  fetch "$NDK_URL" "$NDK_SHA" /tmp/android-ndk-r27d.tar.xz
  rm -rf /opt/android-ndk-r27d.part && mkdir -p /opt/android-ndk-r27d.part
  nice -n 10 tar -xJf /tmp/android-ndk-r27d.tar.xz -C /opt/android-ndk-r27d.part --strip-components=1 --no-same-owner
  rm -rf /opt/android-ndk-r27d && mv /opt/android-ndk-r27d.part /opt/android-ndk-r27d
  ln -sfn /opt/android-ndk-r27d /opt/android-ndk
  rm -f /tmp/android-ndk-r27d.tar.xz
  { echo 'export ANDROID_NDK_HOME=/opt/android-ndk'; echo 'export ANDROID_NDK_ROOT=/opt/android-ndk'
    echo 'export PATH="$PATH:/opt/android-ndk"'; } > /etc/profile.d/android-ndk.sh
}

case "$want" in ndk)
  install_ndk
  say "NDK $(sed -n 's/^Pkg.Revision = //p' /opt/android-ndk/source.properties) in /opt/android-ndk (new terminals have ANDROID_NDK_HOME)"
  ;;
esac

case "$want" in d8)
  install_d8
  say "D8 $(cat /opt/android-sdk/r8/VERSION) in /opt/android-sdk/r8, $(javac -version 2>&1 | head -1)"
  ;;
esac

case "$want" in quest|all)
  say "native Quest apps: APK tools, JDK, NDK, android.jar, OpenXR"
  missing=""
  for c in aapt2 zipalign apksigner keytool javac unzip; do command -v $c >/dev/null || missing="$missing $c"; done
  if [ -n "$missing" ]; then
    say "apt: aapt2, zipalign, apksigner, JDK (not on PATH:$missing; PATH=$PATH)"
    "${APT[@]}" update
    "${APT[@]}" install --no-install-recommends aapt zipalign apksigner default-jdk-headless unzip
  fi
  install_ndk
  P=/opt/android-sdk/platforms/android-34
  if [ ! -f $P/android.jar ]; then
    say "android.jar (Android SDK Platform 34 from dl.google.com; Android SDK License, developer.android.com/studio/terms)"
    fetch "$PLATFORM_URL" "$PLATFORM_SHA" /tmp/platform-34.zip
    rm -rf $P.part && mkdir -p $P.part
    unzip -q -o -j /tmp/platform-34.zip android-34/android.jar android-34/source.properties -d $P.part
    rm -rf $P && mv $P.part $P && rm -f /tmp/platform-34.zip
  fi
  install_d8
  X=/opt/openxr
  if [ ! -f $X/lib/arm64-v8a/libopenxr_loader.so ] || [ ! -f $X/include/openxr/openxr.h ] || [ "$(cat $X/VERSION 2>/dev/null)" != "$OPENXR_VERSION" ]; then
    say "OpenXR $OPENXR_VERSION (Khronos headers + Android loader, Maven Central, Apache-2.0)"
    fetch "$OPENXR_URL" "$OPENXR_SHA" /tmp/openxr-loader.aar
    rm -rf $X.part /tmp/openxr-aar && mkdir -p $X.part/include $X.part/lib/arm64-v8a /tmp/openxr-aar
    unzip -q -o /tmp/openxr-loader.aar 'prefab/modules/headers/include/openxr/*' jni/arm64-v8a/libopenxr_loader.so META-INF/LICENSE -d /tmp/openxr-aar
    mv /tmp/openxr-aar/prefab/modules/headers/include/openxr $X.part/include/openxr
    mv /tmp/openxr-aar/jni/arm64-v8a/libopenxr_loader.so $X.part/lib/arm64-v8a/
    mv /tmp/openxr-aar/META-INF/LICENSE $X.part/LICENSE
    echo "$OPENXR_VERSION" > $X.part/VERSION
    rm -rf $X && mv $X.part $X && rm -rf /tmp/openxr-aar /tmp/openxr-loader.aar
  fi
  { echo 'export ANDROID_JAR=/opt/android-sdk/platforms/android-34/android.jar'; echo 'export OPENXR_HOME=/opt/openxr'; } > /etc/profile.d/metacodex-quest.sh
  mkdir -p /root/metacodex-projects/native /root/metacodex-projects/default /root/metacodex-projects/research
  say "quest: NDK $(sed -n 's/^Pkg.Revision = //p' /opt/android-ndk/source.properties), android.jar API 34, OpenXR $(cat $X/VERSION), D8 $(cat /opt/android-sdk/r8/VERSION), $(aapt2 version 2>&1 | head -1), $(java -version 2>&1 | head -1). Next: mcx-app doctor"
  ;;
esac

case "$want" in agents|all)
  if ! command -v claude >/dev/null; then
    say "cloud agent CLI (official installer)"
    if ! (curl -fsSL https://claude.ai/install.sh | bash) || ! "$HOME/.local/bin/claude" --version >/dev/null 2>&1; then
      say "native build did not run here; using the npm package"
      npm i -g @anthropic-ai/claude-code
    fi
  fi
  command -v opencode >/dev/null || { say "open agent CLI"; npm i -g --allow-scripts=opencode-ai opencode-ai; }
  say "agents: $(claude --version 2>/dev/null | head -1) | open agent $(opencode --version 2>/dev/null | head -1)"
  ;;
esac

case "$want" in qvac|all)
  say "local AI runtime"
  command -v qvac >/dev/null || npm i -g @qvac/cli
  mkdir -p /root/qvac && cd /root/qvac
  [ -f package.json ] || npm init -y >/dev/null
  [ -d node_modules/@qvac/sdk ] || npm i @qvac/sdk
  say "qvac $(qvac --version 2>/dev/null | head -1), sdk $(node -p 'require("/root/qvac/node_modules/@qvac/sdk/package.json").version')"
  ;;
esac
say "done in $(( $(date +%s) - t0 )) s"
