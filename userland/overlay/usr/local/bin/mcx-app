#!/bin/bash
# mcx-app: build native Quest apps in MetaCodex's Linux and install them on this headset (skill quest-native-apps).
#   mcx-app doctor                            are the tools there? may MetaCodex install apps? (run it first)
#   mcx-app new <dir> [--module | --example <name>] [--package <id>] [--label <name>]   a new app (C++, OpenXR, GLES):
#                                             the template; --module: a module (Runner, mcx-app dev); --example
#                                             nightvision: a bundled example (/opt/metacodex/quest-native/examples)
#   mcx-app check [dir]                       compile check only (seconds): errors as file:line:col: error: ...
#   mcx-app build [dir]                       -> <dir>/build/<dir name>.apk, incremental, on cores 0-2 (the headset keeps 72 fps)
#   mcx-app verify [dir]                      static checks of the built APK: manifest entries the Meta APIs in use need,
#                                             unresolved symbols, the OpenXR extensions asked for, icon, devices
#   mcx-app install [dir|apk]                 Android's installer; tells you what to ask the user; waits up to 5 min
#   mcx-app launch [dir|package]              starts the app in the headset (MetaCodex goes to the background)
#   mcx-app run [dir]                         build + install + launch
#   mcx-app dev [dir]                         module apps: compile and run it in the Runner now (seconds, no APK)
#   mcx-app runner                            build + install the Runner app (once; the user confirms the install)
#   mcx-app logs [dir|package] [-f]           what the app logged (template apps send LOG lines to 127.0.0.1:47950)
#   mcx-app info [dir|package]                installed? version, installer of record
# Lines starting with ">>> ASK THE USER" are for the user: say them (short) and wait. "RESULT:" lines are outcomes.
# Exit codes: 0 ok, 1 failed, 2 waiting for the user timed out, 3 MetaCodex cannot install apps in this build.
# Shipped by the app (overlay); edits are overwritten.
set -uo pipefail
TEMPLATE=/opt/metacodex/quest-native/template
MODULE_TEMPLATE=/opt/metacodex/quest-native/module-template
EXAMPLES=/opt/metacodex/quest-native/examples
RUNNER_SRC=/opt/metacodex/quest-native/runner
RUNNER_PKG=${MCX_RUNNER_PKG:-com.metacodex.runner}
LOGD=/opt/metacodex/quest-native/logd.py
LOGPORT=47950
LOGDIR=/tmp/mcx-app-logs
MCX_BUILD=${MCX_BUILD:-mcx-build}
MCX_BUILDD=${MCX_BUILDD:-mcx-buildd}
die() { echo "mcx-app: $*" >&2; exit 1; }
say() { printf '\033[1;36m==> %s\033[0m\n' "$*"; }
ask() { printf '\033[1;33m>>> ASK THE USER: %s\033[0m\n' "$*"; }
ui() { mcx-ui "$@" 2>&1; }

dir_of() {
  local d=${1:-.}
  [ -f "$d/AndroidManifest.xml" ] || die "no AndroidManifest.xml in $d (an app folder made by mcx-app new)"
  readlink -f "$d"
}
pkg_of() { sed -n 's/.*package="\([^"]*\)".*/\1/p' "$1/AndroidManifest.xml" | head -1; }
# a package name (has dots, is not a path) or an app folder
pkg_arg() {
  if [ -n "${1:-}" ] && [ ! -e "$1" ] && [[ "$1" == *.* ]]; then echo "$1"; else pkg_of "$(dir_of "${1:-.}")"; fi
}

start_logd() {
  mkdir -p "$LOGDIR"
  (exec 3<>"/dev/tcp/127.0.0.1/$LOGPORT") 2>/dev/null && return 0 # already listening
  [ -f "$LOGD" ] || return 0
  nohup setsid python3 -I "$LOGD" "$LOGPORT" "$LOGDIR" 1800 >/dev/null 2>&1 &
  sleep 0.3
}

doctor() {
  local bad=0 t f
  if pgrep -f "[m]cx-setup quest" >/dev/null; then
    echo "WAIT the first-use setup is still running (log /root/.metacodex/first-use.log: $(tail -1 /root/.metacodex/first-use.log 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g'))"
    return 1
  fi
  for t in mcx-build mcx-buildd aapt2 openssl python3; do
    if command -v "$t" >/dev/null; then echo "ok      $t"; else echo "MISSING $t"; bad=1; fi
  done
  for f in /opt/android-ndk/toolchains/llvm/prebuilt/linux-arm64/bin/clang++ /opt/android-sdk/platforms/android-34/android.jar \
           /opt/openxr/include/openxr/openxr.h /opt/openxr/lib/arm64-v8a/libopenxr_loader.so "$TEMPLATE/build.sh"; do
    if [ -e "$f" ]; then echo "ok      $f"; else echo "MISSING $f"; bad=1; fi
  done
  if [ -f "$HOME/.android/metacodex-debug.keystore" ]; then echo "ok      signing key ~/.android/metacodex-debug.keystore (keep it)"
  else echo "note    no signing key yet: the first build makes ~/.android/metacodex-debug.keystore"; fi
  if off_frame_loop; then echo "builds  here, on cores 0-2 ($(cat /proc/self/cpuset 2>/dev/null))"
  elif "$MCX_BUILDD" status >/dev/null 2>&1; then echo "builds  through mcx-buildd (cores $("$MCX_BUILDD" status | sed -n 's/.*"cpus": "\([^"]*\)".*/\1/p'))"
  else echo "warn    no builder daemon: builds from this shell would share MetaCodex's rendering cores (MQH starts mcx-buildd)"; fi
  echo "install MetaCodex may install apps (path B): $(ui system can-install)"
  if (( bad )); then echo "fix: mcx-setup quest   (installs everything above: about 400 MB download, 2.5 GB on disk)"; return 1; fi
  return 0
}

new_app() {
  local dir="" pkg="" label="" tpl=$TEMPLATE
  while [ $# -gt 0 ]; do
    case "$1" in
      --module) tpl=$MODULE_TEMPLATE; shift ;;
      --example)
        [ -n "${2:-}" ] && [ -f "$EXAMPLES/$2/AndroidManifest.xml" ] || die "no example '${2:-}' (examples: $(ls "$EXAMPLES" 2>/dev/null | tr '\n' ' '))"
        tpl=$EXAMPLES/$2; shift 2 ;;
      --package) pkg=${2:-}; shift 2 ;;
      --label) label=${2:-}; shift 2 ;;
      -*) die "unknown option $1" ;;
      *) dir=$1; shift ;;
    esac
  done
  [ -n "$dir" ] || die "usage: mcx-app new <dir> [--package com.metacodex.user.<name>] [--label \"Name\"]"
  [ -e "$dir" ] && die "$dir exists already"
  [ -f "$tpl/AndroidManifest.xml" ] || die "no template in $tpl (update MetaCodex)"
  local base id
  base=$(basename "$dir")
  id=$(printf '%s' "$base" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9' '_' | sed 's/^[^a-z]*//; s/_*$//')
  [ -n "$id" ] || id=app
  pkg=${pkg:-com.metacodex.user.$id}
  [[ "$pkg" =~ ^[a-z][a-z0-9_]*(\.[a-z][a-z0-9_]*)+$ ]] || die "bad package name $pkg (lower case, dots: com.metacodex.user.$id)"
  [ "$pkg" = com.pnncl.metacodex ] && die "$pkg is MetaCodex itself"
  [[ "$pkg" == com.oculus.* || "$pkg" == com.meta.* || "$pkg" == android.* || "$pkg" == com.android.* ]] && die "$pkg belongs to the system: pick com.metacodex.user.<name>"
  label=${label:-$base}
  [[ "$label" =~ ^[A-Za-z0-9\ _.,:!?()+-]+$ ]] || die "the label may use letters, digits, spaces and _ . , : ! ? ( ) + -"
  mkdir -p "$(dirname "$dir")"
  cp -r "$tpl" "$dir" || die "copy failed"
  rm -rf "$dir/build"
  sed -i -e "0,/package=\"[^\"]*\"/s|package=\"[^\"]*\"|package=\"$pkg\"|" -e "s|android:label=\"[^\"]*\"|android:label=\"$label\"|" \
    -e "s|android:name=\"android.app.lib_name\" android:value=\"hellonative\"|android:name=\"android.app.lib_name\" android:value=\"main\"|" "$dir/AndroidManifest.xml"
  [ -f "$dir/build.sh" ] && chmod +x "$dir/build.sh"
  say "new app $pkg (\"$label\") in $(readlink -f "$dir")"
  if [[ "$tpl" == "$EXAMPLES"/* ]]; then
    echo "files: AndroidManifest.xml (package, label, versionCode, permissions), src/ (the app on mcx_xr.h), res/ (icon)"
    echo "next:  mcx-app build $dir && mcx-app verify $dir   then  mcx-app install $dir && mcx-app launch $dir"
  elif [ "$tpl" = "$MODULE_TEMPLATE" ]; then
    echo "files: AndroidManifest.xml (package, label, versionCode), src/app.cpp (the module: mcx_app_init/frame/draw/shutdown,"
    echo "       header $RUNNER_SRC/mcx_module.h), build.conf (TYPE=module); optional res/ and assets/"
    echo "next:  mcx-app dev $dir   (runs it in the Runner in seconds; once: mcx-app runner)  then  mcx-app run $dir  (its own APK)"
  else
    echo "files: AndroidManifest.xml (package, label, versionCode), src/main.cpp (the app), build.sh; optional res/ and assets/"
    echo "next:  mcx-app run $dir   (build + install + launch; the user confirms the install in the headset)"
  fi
}

# Builds run on cores 0-2, never next to the frame loop (cores 3-5, where MetaCodex and its own terminals live):
# here when this shell may use those cores (MQH's agents run under the app's service process), else through the
# builder daemon (mcx-buildd, started by MQH). Without a daemon: here, at the lowest priority, one job, with a warning.
off_frame_loop() { [ "$(cat /proc/self/cpuset 2>/dev/null)" != /immersive ] && taskset -c 0-2 true 2>/dev/null; }
builder() {
  if off_frame_loop; then
    nice -n 10 taskset -c 0-2 "$MCX_BUILD" "$@"; return
  fi
  local rc
  if command -v "$MCX_BUILDD" >/dev/null; then
    "$MCX_BUILDD" run -- "$@"; rc=$?
    [ "$rc" -ne 100 ] && return "$rc"
  fi
  echo "mcx-app: warning: no builder daemon (MQH starts mcx-buildd): building in this shell, which shares MetaCodex's rendering cores, at the lowest priority" >&2
  nice -n 19 "$MCX_BUILD" -j1 "$@"
}

build_app() {
  local d; d=$(dir_of "${1:-.}")
  say "building $(pkg_of "$d")"
  builder "$d"
}

check_app() {
  local d; d=$(dir_of "${1:-.}")
  builder --check "$d"
}

# the Runner: MetaCodex's native host without a module, built here once (same signing key as every app)
runner_dir() { echo "$HOME/.cache/mcx-build/runner-app/runner"; }
runner_app() {
  local d; d=$(runner_dir)
  [ -f "$RUNNER_SRC/AndroidManifest.xml" ] || die "no Runner in $RUNNER_SRC (update MetaCodex)"
  mkdir -p "$d"
  cmp -s "$RUNNER_SRC/AndroidManifest.xml" "$d/AndroidManifest.xml" || cp "$RUNNER_SRC/AndroidManifest.xml" "$d/AndroidManifest.xml"
  cmp -s "$RUNNER_SRC/build.conf" "$d/build.conf" || cp "$RUNNER_SRC/build.conf" "$d/build.conf"
  [ "$RUNNER_PKG" = com.metacodex.runner ] || sed -i "s|package=\"com.metacodex.runner\"|package=\"$RUNNER_PKG\"|" "$d/AndroidManifest.xml"
  say "building the Runner ($RUNNER_PKG)"
  builder "$d" || return 1
  install_app "$d/build/runner.apk"
}

dev_app() {
  local d mod pkg r sha i st t0 info
  d=$(dir_of "${1:-.}")
  grep -q '^TYPE=module' "$d/build.conf" 2>/dev/null || die "$d is not a module app (build.conf TYPE=module; make one with mcx-app new <dir> --module)"
  pkg=$(pkg_of "$d")
  t0=$(date +%s.%N)
  builder --module-only "$d" || return 1
  mod="$d/build/lib/arm64-v8a/libapp.so"
  sha=$(sha256sum "$mod" | cut -c1-64)
  r=$("$MCX_BUILDD" dev "$mod" "$pkg") || { echo "RESULT: the dev server is not available: $r"; return 1; }
  start_logd
  # the Runner asks every ~0.4 s while it is in front; if nobody asked lately, start it
  st=$("$MCX_BUILDD" dev-status)
  if ! python3 -I -c 'import json,sys,time; j=json.loads(sys.argv[1]); f=j.get("fetches") or []; sys.exit(0 if f and time.time()-f[-1]["t"] < 3 else 1)' "$st"; then
    info=$(ui system app "$RUNNER_PKG")
    if [[ "$info" != installed* ]]; then
      echo "RESULT: the Runner is not installed: mcx-app runner (once), then mcx-app dev again"; return 2
    fi
    r=$(ui system launch "$RUNNER_PKG"); [[ "$r" == ok* ]] || { echo "RESULT: cannot start the Runner: $r"; return 1; }
    say "starting the Runner"
  fi
  for i in $(seq 1 100); do
    st=$("$MCX_BUILDD" dev-status)
    if python3 -I -c 'import json,sys; j=json.loads(sys.argv[1]); sys.exit(0 if any(f["sha"]==sys.argv[2] for f in j.get("fetches") or []) else 1)' "$st" "$sha"; then
      echo "RESULT: running in the Runner: module ${sha:0:12} delivered $(python3 -I -c "import time; print(round(time.time()-$t0,1))") s after the command started"
      echo "its log: mcx-app logs $RUNNER_PKG   (\"module loaded\" lines; a crash ends the log)"
      return 0
    fi
    sleep 0.2
  done
  echo "RESULT: the Runner did not fetch the module in 20 s: is it in front? (mcx-app logs $RUNNER_PKG)"
  return 2
}

hint() {
  case "$1" in
    *UPDATE_INCOMPATIBLE*|*signatures*|*"(5)"*) echo "hint: an app with this package is installed with another signing key or by another installer: ask the user to uninstall it (Library > the app > ... > Uninstall), or use a new package name" ;;
    *VERSION_DOWNGRADE*) echo "hint: the installed versionCode is higher: raise android:versionCode in AndroidManifest.xml" ;;
    *"(3)"*) echo "hint: the user cancelled the dialog (or closed it): ask before installing again" ;;
    *NO_MATCHING_ABIS*|*"(7)"*) echo "hint: incompatible APK: lib/arm64-v8a missing or minSdkVersion above the headset's API 34" ;;
    *INSUFFICIENT_STORAGE*|*"(6)"*) echo "hint: the headset is out of space: mcx-ui system storage" ;;
    *PARSE*|*"(4)"*) echo "hint: the APK is broken or not signed: mcx-app build again" ;;
    *"(2)"*) echo "hint: Android blocked the install (policy)" ;;
  esac
}

install_app() {
  local a=${1:-.} apk d ci r st last="" asked=0 i
  if [[ "$a" == *.apk ]]; then apk=$(readlink -f "$a"); else d=$(dir_of "$a"); apk="$d/build/$(basename "$d").apk"; fi
  [ -f "$apk" ] || die "no $apk: mcx-app build first"
  ci=$(ui system can-install)
  case "$ci" in
    yes*) ;;
    unavailable*) echo "RESULT: $ci"; return 3 ;;
    no*)
      ui system install-apk "$apk" >/dev/null # opens Android's "Install unknown apps" page for MetaCodex
      ask "Android's 'Install unknown apps' page is open in the headset: turn on 'Allow from this source' for MetaCodex, then come back to MetaCodex. This is needed once per headset."
      for i in $(seq 1 100); do sleep 3; ci=$(ui system can-install); [[ "$ci" == yes* ]] && break; done
      [[ "$ci" == yes* ]] || { echo "RESULT: MetaCodex may not install apps yet (the switch is off): ask the user, then mcx-app install again"; return 2; }
      say "MetaCodex may install apps now"
      ;;
    *) echo "RESULT: cannot reach the app: $ci"; return 1 ;;
  esac
  start_logd
  r=$(ui system install-apk "$apk")
  [[ "$r" == installing* ]] || { echo "RESULT: $r"; hint "$r"; return 1; }
  say "$r"
  for i in $(seq 1 150); do
    sleep 2
    st=$(ui system install-status)
    [ "$st" = "$last" ] && continue
    last=$st
    case "$st" in
      waiting*) (( asked )) || { ask "Android asks to install the app in the headset: tap Install (Update for a new version)."; asked=1; } ;;
      success*) echo "RESULT: installed. $st"; return 0 ;;
      failure*) echo "RESULT: $st"; hint "$st"; return 1 ;;
    esac
  done
  echo "RESULT: no answer in 5 minutes (last: $last): ask the user whether Android's install dialog is still open"
  return 2
}

launch_app() {
  local pkg r; pkg=$(pkg_arg "${1:-}")
  start_logd
  r=$(ui system launch "$pkg")
  if [[ "$r" == ok* ]]; then
    echo "RESULT: started $pkg"
    ask "The app is open in the headset (MetaCodex is in the background). Try it, then open MetaCodex again from the Library and tell me what you saw."
    echo "its log: mcx-app logs $pkg"
  else
    echo "RESULT: $r"; return 1
  fi
}

logs_app() {
  local follow=0 a="" x pkg f
  for x in "$@"; do if [ "$x" = -f ]; then follow=1; else a=$x; fi; done
  pkg=$(pkg_arg "$a")
  f="$LOGDIR/$pkg.log"
  start_logd
  if [ ! -f "$f" ]; then echo "no log lines from $pkg yet (it sends them while it runs, from its first LOG line; start it with mcx-app launch)"; return 0; fi
  if (( follow )); then tail -n 50 -f "$f"; else tail -n 200 "$f"; fi
}

cmd=${1:-}
[ $# -gt 0 ] && shift
case "$cmd" in
  doctor) doctor ;;
  new) new_app "$@" ;;
  check) check_app "${1:-.}" ;;
  build) build_app "${1:-.}" ;;
  install) install_app "${1:-.}" ;;
  launch) launch_app "${1:-}" ;;
  run) build_app "${1:-.}" && install_app "${1:-.}" && launch_app "${1:-.}" ;;
  dev) dev_app "${1:-.}" ;;
  verify) "$MCX_BUILD" --verify "$(dir_of "${1:-.}")" ;;
  runner) runner_app ;;
  logs) logs_app "$@" ;;
  info) echo "$(ui system app "$(pkg_arg "${1:-}")")" ;;
  *) sed -n 2,19p "$0"; exit 2 ;;
esac
