#!/bin/bash
# mcx-secret: ask the MetaCodex app's vault for a secret (values are typed in VR and sealed by the
# Android Keystore; they never sit in files in this Linux). Each secret's policy decides: "ask" pops an
# ALLOW / DENY dialog in the headset, "once" is handed out once per app session, "allow" always, "deny" never.
#   mcx-secret get NAME                    print the value (stdout only; nothing is written to disk)
#   mcx-secret env NAME[=VAR]... -- CMD    run CMD with the secrets as environment variables
#   mcx-secret ensure NAME BYTES           a random key made by the app on first use (hex), e.g. MQH's key
#   mcx-secret list | status               names and policies (never values)
#   mcx-secret git-credential NAME get     git's credential helper for github.com (VAULT > GIT > GIT USES IT):
#                                          git config credential.https://github.com.helper '!mcx-secret git-credential GITHUB_TOKEN'
# Exit status 1 when the app denies, nobody answers within ~2 minutes, or the app is not running.
set -euo pipefail
TOKEN_FILE=${MCX_TOKEN_FILE:-/mnt/quest/control.token}
PORT=${MCX_CONTROL_PORT:-47800}
WHO=${MCX_SECRET_WHO:-"$(basename "$(readlink -f /proc/$PPID/exe 2>/dev/null || echo sh)") (pid $PPID)"}

ask() { # one control-port request; prints the reply lines
  [[ -r "$TOKEN_FILE" ]] || { echo "mcx-secret: no $TOKEN_FILE (is the MetaCodex app running?)" >&2; return 1; }
  exec 3<>"/dev/tcp/127.0.0.1/$PORT" || { echo "mcx-secret: control port $PORT closed" >&2; return 1; }
  printf 'auth %s\n%s\n' "$(cat "$TOKEN_FILE")" "$*" >&3
  local n=0 line
  while IFS= read -r -t 130 line <&3; do
    [[ "$line" == "." ]] && { n=$((n+1)); [[ $n -ge 2 ]] && break; continue; }
    [[ $n -ge 1 ]] && printf '%s\n' "$line"
  done
  exec 3>&-
}

value_of() { # NAME [ensure BYTES] -> the value on stdout, or an error on stderr
  local reply
  if [[ "${2:-}" == ensure ]]; then reply=$(ask secret ensure "$1" "$3" "$WHO"); else reply=$(ask secret get "$1" "$WHO"); fi
  if [[ "$reply" == value\ * ]]; then printf '%s' "${reply#value }"; return 0; fi
  echo "mcx-secret: $1: ${reply:-no reply}" >&2
  return 1
}

cmd=${1:-}; shift || true
case "$cmd" in
  get)    [[ $# -eq 1 ]] || { echo "usage: mcx-secret get NAME" >&2; exit 2; }; value_of "$1"; echo ;;
  ensure) [[ $# -eq 2 ]] || { echo "usage: mcx-secret ensure NAME BYTES" >&2; exit 2; }; value_of "$1" ensure "$2"; echo ;;
  list)   ask secret list ;;
  status) ask secret status ;;
  env)
    envs=()
    while [[ $# -gt 0 && "$1" != "--" ]]; do
      spec=$1; shift
      name=${spec%%=*}; var=${spec#*=}; [[ "$spec" == *=* ]] || var=$name
      v=$(value_of "$name") || exit 1
      envs+=("$var=$v")
    done
    [[ "${1:-}" == "--" ]] && shift || { echo "usage: mcx-secret env NAME[=VAR]... -- CMD [ARGS]" >&2; exit 2; }
    [[ $# -gt 0 ]] || { echo "mcx-secret env: no command" >&2; exit 2; }
    exec env "${envs[@]}" "$@" ;;
  git-credential)
    name=${1:-GITHUB_TOKEN}; op=${2:-get}
    [[ "$op" == get ]] || exit 0 # store / erase: the vault keeps the token
    host=""
    while IFS= read -r line && [[ -n "$line" ]]; do [[ "$line" == host=* ]] && host=${line#host=}; done
    [[ -z "$host" || "$host" == github.com ]] || exit 0
    WHO="git (credential helper)"
    v=$(value_of "$name") || exit 0
    printf 'username=x-access-token\npassword=%s\n' "$v" ;;
  *) sed -n 2,11p "$0" >&2; exit 2 ;;
esac
