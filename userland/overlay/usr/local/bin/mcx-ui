#!/bin/bash
# mcx-ui: talk to the MetaCodex app's control port from inside the headset's Linux (agents use this).
#   mcx-ui ui list | ui open files | ui toast hello | ui layout float
#   mcx-ui script list | script log <name> | script eval 'return 1+1' | script dir
#   mcx-ui gesture clap        (simulates a recognised gesture: test a script without moving your hands)
#   mcx-ui gesture list | gesture bindings | gesture bind thumbs-up open:git | gesture unbind thumbs-up
#   mcx-ui plugin list | plugin log <id> | plugin new <name> app|gesture|behaviour | plugin examples | plugin example <id> | plugin enable|disable|delete <id> | plugin reload | plugin check <id>
#                (new: a plugin project in /root/metacodex-projects/plugins/<apps|gestures|behaviours>/<id>, kind fixed;
#                 check: loaded or error, kind, folder, windows, tiles, timers, the last warnings; run it after a plugin edit)
#   mcx-ui plugin event <id> input add buy milk | plugin event <id> cell item-3 | plugin event <id> toggle sound true
#                (a tap or a sent text in a plugin's window, as the user would; <id>: the plugin (its main window) or a full window id)
#   mcx-ui action open:git     (any action: open/close/toggle:<panel>, toast:, run:, url:, layout:, spin:, voice:, ...)
#   mcx-ui voice run "close all windows" | voice say "hello" | voice list | voice status | voice match "open git"
#   mcx-ui voice listen | voice wav /mnt/quest/cmd.wav | voice install | voice threads 2 | voice lang en
#   mcx-ui voice registry      (every enabled command as JSON: schema, names, samples, warnings) | voice decide "text"
#   mcx-ui view show spec.json | view show - (stdin) | view mermaid f.mmd | view list | view wait <id> | view schema
#   mcx-ui system tools [json] | system refresh | system storage   (installed tools: /mnt/quest/system/tools.json)
#   mcx-ui system can-install | system install-apk <apk> | system install-status | system app <pkg> | system launch <pkg>
#                              (native apps: Android's installer, the user confirms; use mcx-app, skill quest-native-apps)
#   mcx-ui system first-use    (the setup MetaCodex runs by itself once: base tools, Node, native app tools)
#   mcx-ui system ide open [folder] | ide start | ide stop | ide status   (the code editor: mcx-ide, docs/ide.md)
#   mcx-ui capture list | capture dir | capture clear   (the user's captures: PNGs of windows, newest first)
#   mcx-ui status | screen
# The token is new at every app start: /mnt/quest/control.token (the app's shared folder).
set -euo pipefail
TOKEN_FILE=${MCX_TOKEN_FILE:-/mnt/quest/control.token}
PORT=${MCX_CONTROL_PORT:-47800}
[[ $# -gt 0 ]] || { sed -n 2,24p "$0"; exit 2; }
# views: the app reads the spec file itself (any size), so pass an absolute path; '-' takes stdin
if [[ "$1" == view && ( "${2:-}" == show || "${2:-}" == mermaid ) && -n "${3:-}" ]]; then
  f=$3
  if [[ "$f" == - ]]; then mkdir -p /tmp/mcx-views; f=/tmp/mcx-views/stdin-$$.json; cat > "$f"; fi
  if [[ -r "$f" ]]; then set -- view "$2" "$(readlink -f "$f")"; elif [[ "$2" == show ]]; then echo "mcx-ui: no file $f" >&2; exit 1; fi
fi
# plugin check <id>: the app's eval sandbox has check(id) (windows, tiles, timers, last warnings)
if [[ "$1" == plugin && "${2:-}" == check ]]; then
  [[ "${3:-}" =~ ^[A-Za-z0-9_-]+$ ]] || { echo "usage: mcx-ui plugin check <id>   (the id: letters, digits, - and _)" >&2; exit 2; }
  set -- script eval "return check(\"$3\")"
fi
[[ -r "$TOKEN_FILE" ]] || { echo "mcx-ui: no $TOKEN_FILE (is the MetaCodex app running?)" >&2; exit 1; }
exec 3<>"/dev/tcp/127.0.0.1/$PORT" || { echo "mcx-ui: control port $PORT closed" >&2; exit 1; }
printf 'auth %s\n%s\n' "$(cat "$TOKEN_FILE")" "$*" >&3
n=0
WAIT=10
[[ "$1" == voice || "$1" == secret || ( "$1" == view && "${2:-}" == wait ) ]] && WAIT=130 # answered after speech-to-text / the LLM / your approval / your choice in VR
while IFS= read -r -t "$WAIT" line <&3; do
  [[ "$line" == "." ]] && { n=$((n+1)); [[ $n -ge 2 ]] && break; continue; }
  [[ $n -ge 1 ]] && printf '%s\n' "$line"
done
exec 3>&-
