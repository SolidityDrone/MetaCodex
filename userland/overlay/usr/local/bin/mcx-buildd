#!/usr/bin/python3 -I
"""mcx-buildd: runs native app builds (mcx-build) away from MetaCodex's frame loop, one job at a time.

  mcx-buildd ensure            start the daemon unless it runs (MQH's mqh-run does this at start)
  mcx-buildd serve             the daemon itself (foreground)
  mcx-buildd status            JSON: pid, CPU set, cores, the running job, the queue, the last result
  mcx-buildd run [--] <mcx-build args>   hand a job to the daemon and print its output (exit = the job's exit)
  mcx-buildd stop              stop the daemon
  mcx-buildd dev <libapp.so> <package>   serve this module to the Runner (127.0.0.1:47951); `mcx-app dev` calls it
  mcx-buildd dev-status        JSON: the module served and the Runner's last fetches

Why: Horizon OS keeps MetaCodex and every process it starts (its terminals too) on cores 3-5, the frame loop's
cores; only processes of the app's service process (":ai", where MQH runs) sit on cores 0-2. MQH starts this
daemon, so jobs handed to it from any shell build on cores 0-2 (docs/native-build-and-install.md).
Socket: /tmp/mcx-buildd/sock (a folder only root of this Linux can open; other Android apps cannot reach it).
While a job runs /tmp/mcx-buildd/busy exists (MetaCodex's service holds a wake lock while it does).
The dev server: the Runner app (another Android app, so TCP on 127.0.0.1) asks for the current module with a nonce;
the answer carries an RSA signature (the APK signing key) over "MCXR1|<nonce>|<sha256>", which the Runner checks
with the public key in its assets: an app that takes the port first cannot feed it code, old modules cannot be
replayed. The warm JVM (2D panel apps): mcx-build asks the daemon ({"op": "java"}) to run javac or D8 in one JVM
(McxJavaServer: javax.tools and D8's API), started on the first request on the same cores and nice level, stopped after
MCX_BUILDD_JVM_IDLE seconds (default 300) without one, when memory runs low, or with the daemon; without a daemon
mcx-build starts a JVM per tool. While MetaCodex is in the background (its :ai process at oom_score_adj >= 600, i.e. no foreground service) a job is
paused whenever the builder's CPU over the last 5 minutes would pass 15 %: Android kills the whole :ai process
(MQH, agents, local AI) when its children pass 25 %. A client that goes away (Ctrl+C) cancels its job. Exit 100 from `run`: no daemon (mcx-app then builds itself).
Shipped by MetaCodex (overlay); edits are overwritten.
"""
import hashlib
import json
import os
import shutil
import signal
import socket
import subprocess
import sys
import threading
import time

D = os.environ.get("MCX_BUILDD_DIR", "/tmp/mcx-buildd")
SOCK = os.path.join(D, "sock")
BUSY = os.path.join(D, "busy")
PIDF = os.path.join(D, "pid")
LOG = os.environ.get("MCX_BUILDD_LOG", os.path.expanduser("~/.metacodex/buildd.log"))
NICE = int(os.environ.get("MCX_BUILDD_NICE", "10"))
MAX_QUEUE = 4
HERE = os.path.dirname(os.path.realpath(__file__))


CACHE = os.environ.get("MCX_BUILD_CACHE", os.path.expanduser("~/.cache/mcx-build"))
JSERVER_SRC = os.environ.get("MCX_JSERVER_SRC", "/opt/metacodex/quest-native/jserver/McxJavaServer.java")
JVM_IDLE = float(os.environ.get("MCX_BUILDD_JVM_IDLE", "300"))
MIN_MB = int(os.environ.get("MCX_BUILD_MIN_MB", "900"))
KILL_MB = int(os.environ.get("MCX_BUILD_KILL_MB", "450"))


def mem_available_mb():
    for line in read("/proc/meminfo").splitlines():
        if line.startswith("MemAvailable:"):
            return int(line.split()[1]) // 1024
    return -1


def proc_cpu(pid):
    """CPU seconds of one process (and the children it reaped)."""
    try:
        with open(f"/proc/{pid}/stat") as f:
            st = f.read()
        f_ = st[st.rindex(")") + 2:].split()
        return (int(f_[11]) + int(f_[12]) + int(f_[13]) + int(f_[14])) / os.sysconf("SC_CLK_TCK")
    except (OSError, ValueError, IndexError):
        return 0.0


def mcx_build():
    for p in (os.path.join(HERE, "mcx-build"), "/usr/local/bin/mcx-build"):
        if os.path.exists(p):
            return p
    return shutil.which("mcx-build") or "mcx-build"


def read(path):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return ""


def cpus():
    for line in read("/proc/self/status").splitlines():
        if line.startswith("Cpus_allowed_list:"):
            return line.split(":", 1)[1].strip()
    return "?"


def log(msg):
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        with open(LOG, "a") as f:
            f.write(time.strftime("%F %T ") + msg + "\n")
    except OSError:
        pass


DEV_PORT = int(os.environ.get("MCX_DEV_PORT", "47951"))
# Android kills a background app process whose child processes used more than 25 % CPU over 5 minutes
# ("Killing ...:ai (adj 700): Caused by child process: excessive cpu 78510 during 300014 ... limit=25", seen on the
# Quest 3S with the headset asleep). A foreground service is exempt. While MetaCodex is in the background the
# builder keeps its own share under BG_SHARE of any BG_WINDOW seconds (MQH and the local AI count too).
BG_WINDOW = 300.0
BG_SHARE = float(os.environ.get("MCX_BUILDD_BG_SHARE", "0.15"))
BG_ADJ = 600  # oom_score_adj at or above it: the app is in the background without a foreground service
CLK = os.sysconf("SC_CLK_TCK")


def app_process():
    """The Android process this Linux runs under (MetaCodex's :ai service): walk up the parents."""
    if os.environ.get("MCX_BUILDD_APP_PID"):  # tests
        return int(os.environ["MCX_BUILDD_APP_PID"])
    pid = os.getpid()
    for _ in range(40):
        try:
            with open(f"/proc/{pid}/stat") as f:
                st = f.read()
            ppid = int(st[st.rindex(")") + 2:].split()[1])
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                cmd = f.read().split(b"\0")[0].decode("utf-8", "replace")
        except (OSError, ValueError):
            return None
        if cmd.startswith("com.pnncl.metacodex"):
            return pid
        if ppid <= 1:
            return None
        pid = ppid
    return None


def app_adj(pid):
    if os.environ.get("MCX_BUILDD_FORCE_BG"):
        return 900
    try:
        with open(f"/proc/{pid}/oom_score_adj") as f:
            return int(f.read().strip())
    except (OSError, ValueError, TypeError):
        return None


def group_cpu(pgid):
    """CPU seconds of a job: every live process of its group, plus what its leader reaped."""
    total = 0
    try:
        names = os.listdir("/proc")
    except OSError:
        return 0.0
    for n in names:
        if not n.isdigit():
            continue
        try:
            with open(f"/proc/{n}/stat") as f:
                st = f.read()
            f_ = st[st.rindex(")") + 2:].split()
            if int(f_[2]) != pgid:
                continue
            total += int(f_[11]) + int(f_[12])
            if int(n) == pgid:
                total += int(f_[13]) + int(f_[14])
        except (OSError, ValueError, IndexError):
            continue
    return total / CLK


PAUSE = os.path.join(D, "pause")


class CpuBudget:
    """Samples the running job's CPU each second; pauses it while the app is in the background and the builder's
    CPU over the last BG_WINDOW s would pass BG_SHARE; resumes it when the window allows. The pause is cooperative
    (the pause file, which mcx-build waits on before each stage and each compile): SIGSTOP does not stop processes
    traced by proot (measured: the job ran on)."""

    def __init__(self):
        self.app = app_process()
        self.samples = []  # (time, cumulative builder cpu seconds)
        self.base = 0.0    # cpu of finished jobs
        self.paused_s = 0.0
        self.state = "idle"

    def used(self, now, cur):
        while len(self.samples) > 1 and self.samples[1][0] < now - BG_WINDOW:
            self.samples.pop(0)
        if not self.samples:
            return 0.0
        return cur - self.samples[0][1]

    def watch(self, pgid, done, extra=None):
        """extra: the warm JVM's CPU seconds (another process group, working for this job)."""
        stopped = False
        last_cpu = 0.0
        extra0 = extra() if extra else 0.0
        while not done.is_set():
            now = time.time()
            cpu = group_cpu(pgid) + (max(0.0, extra() - extra0) if extra else 0.0)
            last_cpu = max(last_cpu, cpu)
            cur = self.base + last_cpu
            self.samples.append((now, cur))
            adj = app_adj(self.app) if self.app else None
            bg = adj is not None and adj >= BG_ADJ
            over = self.used(now, cur) > BG_SHARE * BG_WINDOW
            try:
                if bg and over and not stopped:
                    with open(PAUSE, "w") as f:
                        f.write(f"MetaCodex is in the background (adj {adj}): builder CPU over {BG_SHARE:.0%} of 5 min\n")
                    stopped = True
                    log(f"cpu budget: MetaCodex in the background (adj {adj}): job paused to stay under {BG_SHARE:.1%} CPU")
                elif stopped and (not bg or not over):
                    os.remove(PAUSE)
                    stopped = False
                    log(f"cpu budget: job resumed (adj {adj})")
            except OSError:
                pass
            if stopped:
                self.paused_s += 1.0
            self.state = "paused (background budget)" if stopped else ("background" if bg else "foreground")
            done.wait(1.0)
        if stopped:
            try:
                os.remove(PAUSE)
            except OSError:
                pass
        self.base += last_cpu
        self.state = "idle"


def signing_key():
    """The APK signing key, through mcx-build's own loader (one implementation of the keystore handling)."""
    import importlib.machinery
    import importlib.util
    loader = importlib.machinery.SourceFileLoader("mcx_build", mcx_build())
    spec = importlib.util.spec_from_loader("mcx_build", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod.keystore_key(mod.Toolchain())


class DevServer:
    def __init__(self):
        self.lock = threading.Lock()
        self.module = None  # {"path", "package", "sha", "bytes", "set"}
        self.fetches = []   # [{"t", "sha", "package", "sent"}], newest last
        self.key = None
        self.error = None
        self.started = False

    def start(self):
        if self.started:
            return self.error is None
        self.started = True
        try:
            self.key = signing_key()
            if self.key is None:
                raise OSError("no signing key (openssl + ~/.android/metacodex-debug.keystore)")
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            for i in range(20):  # a listener that just closed (a restarted daemon) holds the port for a moment
                try:
                    s.bind(("127.0.0.1", DEV_PORT))
                    break
                except OSError as e:
                    if e.errno != 98 or i == 19:
                        raise
                    time.sleep(0.5)
            s.listen(4)
        except OSError as e:
            self.error = f"dev server: {e}" + (" (another app holds the port: the Runner would refuse its modules anyway)"
                                                if getattr(e, "errno", 0) == 98 else "")
            log(self.error)
            return False
        threading.Thread(target=self.serve, args=(s,), daemon=True).start()
        log(f"dev server on 127.0.0.1:{DEV_PORT}")
        return True

    def set(self, path, package):
        data = open(path, "rb").read()
        import hashlib
        with self.lock:
            self.module = {"path": path, "package": package, "sha": hashlib.sha256(data).hexdigest(), "bytes": len(data), "set": time.time()}
            return dict(self.module)

    def serve(self, s):
        while True:
            c, _ = s.accept()
            threading.Thread(target=self.one, args=(c,), daemon=True).start()

    def one(self, c):
        import hashlib
        try:
            c.settimeout(5)
            f = c.makefile("rwb", buffering=0)
            parts = f.readline(512).decode("ascii", "replace").split()
            if len(parts) < 3 or parts[0] != "MCXR1" or len(parts[1]) != 32:
                return
            nonce, cur = parts[1], parts[2]
            who = parts[3] if len(parts) > 3 else "?"
            with self.lock:
                m = dict(self.module) if self.module else None
            if not m:
                f.write(b"NONE\n")
                return
            data = open(m["path"], "rb").read()
            sha = hashlib.sha256(data).hexdigest()
            sent = sha != cur
            with self.lock:
                self.fetches = (self.fetches + [{"t": time.time(), "sha": sha, "runner": who, "sent": sent}])[-20:]
            if not sent:
                f.write(b"SAME\n")
                return
            sig = self.key.sign_sha256(f"MCXR1|{nonce}|{sha}".encode()).hex()
            f.write(f"MOD {len(data)} {sha} {sig}\n".encode() + data)
            log(f"dev: sent {m['package']} module {sha[:12]} ({len(data)} bytes) to {who}")
        except OSError:
            pass
        finally:
            try:
                c.close()
            except OSError:
                pass

    def status(self):
        with self.lock:
            return {"port": DEV_PORT, "error": self.error, "module": self.module, "fetches": self.fetches[-5:]}


class JavaServer:
    """The warm JVM of 2D panel builds: McxJavaServer (javac through javax.tools, D8 through its API) in one process,
    compiled once per source and JDK into the build cache, started on the first request at the daemon's nice level on
    its cores, stopped after JVM_IDLE s without a request, when MemAvailable stays under MIN_MB while idle, under
    KILL_MB during a request (exit 4, as mcx-build's own guard), or with the daemon. One request at a time."""

    def __init__(self, pin):
        self.pin = pin
        self.lock = threading.Lock()
        self.p = None
        self.last = 0.0
        self.calls = 0
        self.started = 0.0
        self.error = None
        threading.Thread(target=self._idler, daemon=True).start()

    @staticmethod
    def tools():
        sdk = os.environ.get("ANDROID_HOME") or "/opt/android-sdk"
        return (os.environ.get("JAVA") or shutil.which("java"), os.environ.get("JAVAC") or shutil.which("javac"),
                os.environ.get("MCX_R8_JAR") or os.path.join(sdk, "r8", "r8.jar"))

    def _classes(self, javac, r8):
        src = open(JSERVER_SRC, "rb").read()
        st = os.stat(os.path.realpath(javac))
        key = hashlib.sha256(src + f"|{os.path.realpath(javac)}:{st.st_size}:{int(st.st_mtime)}|{os.path.getsize(r8)}".encode()).hexdigest()[:16]
        out = os.path.join(CACHE, f"jserver-{key}")
        if os.path.exists(os.path.join(out, "McxJavaServer.class")):
            return out
        tmp = out + f".{os.getpid()}.tmp"
        shutil.rmtree(tmp, ignore_errors=True)
        os.makedirs(tmp)
        r = subprocess.run(["nice", "-n", str(NICE)] + self.pin + [javac, "-J-XX:+UseSerialGC", "-J-XX:TieredStopAtLevel=1",
                            "--release", "17", "-encoding", "UTF-8", "-proc:none", "-cp", r8, "-d", tmp, JSERVER_SRC],
                           capture_output=True, text=True, timeout=300)
        if r.returncode != 0:
            shutil.rmtree(tmp, ignore_errors=True)
            raise OSError("its server did not compile: " + (r.stdout + r.stderr).strip()[-300:])
        shutil.rmtree(out, ignore_errors=True)
        os.replace(tmp, out)
        return out

    def _start(self):
        java, javac, r8 = self.tools()
        if not java or not javac:
            raise OSError("no JDK (mcx-setup quest)")
        if not os.path.exists(r8):
            raise OSError("no D8 yet (mcx-setup d8)")
        if not os.path.exists(JSERVER_SRC):
            raise OSError(f"no {JSERVER_SRC} (update MetaCodex)")
        mb = mem_available_mb()
        if 0 <= mb < MIN_MB:
            raise OSError(f"MemAvailable {mb} MB < {MIN_MB} MB")
        t0 = time.time()
        cls = self._classes(javac, r8)
        cmd = ["nice", "-n", str(NICE)] + self.pin + [
            java, "-XX:+UseSerialGC", "-Xms32m", "-Xmx512m", "-XX:MinHeapFreeRatio=10", "-XX:MaxHeapFreeRatio=30",
            "-XX:ActiveProcessorCount=2", "-XX:CICompilerCount=2", "-XX:+ExitOnOutOfMemoryError", "-Xshare:auto",
            "-cp", cls + os.pathsep + r8, "McxJavaServer"]
        err = open(LOG, "a")
        p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=err, start_new_session=True)
        err.close()
        hello = p.stdout.readline()
        if not hello.startswith(b"READY"):
            try:
                p.kill()
            except OSError:
                pass
            raise OSError("it did not start (see " + LOG + ")")
        self.p, self.started, self.calls = p, time.time(), 0
        log(f"warm JVM: pid {p.pid}, Java {hello.decode().split()[-1]}, ready in {time.time() - t0:.1f} s")

    def stop(self, why):
        p, self.p = self.p, None
        if p is None:
            return
        try:
            p.stdin.close()  # the server ends at the end of its input
            p.wait(3)
        except (OSError, subprocess.TimeoutExpired):
            try:
                p.kill()
            except OSError:
                pass
        log(f"warm JVM stopped: {why} (after {self.calls} request(s))")

    def _idler(self):
        while True:
            time.sleep(5)
            if self.p is None:
                continue
            idle = time.time() - self.last
            mb = mem_available_mb()
            why = f"idle {idle:.0f} s" if idle > JVM_IDLE else (f"MemAvailable {mb} MB < {MIN_MB} MB" if 0 <= mb < MIN_MB else None)
            if why and self.lock.acquire(blocking=False):
                try:
                    self.stop(why)
                finally:
                    self.lock.release()

    def cpu(self):
        p = self.p
        return proc_cpu(p.pid) if p is not None and p.poll() is None else 0.0

    def call(self, tool, argv):
        """(exit, output, ms) of javac or D8 in the warm JVM; OSError when it cannot run (the caller starts its own)."""
        with self.lock:
            if self.p is not None and self.p.poll() is not None:
                self.p = None
            if self.p is None:
                self._start()
            self.last = time.time()
            p = self.p
            killed, done = [], threading.Event()

            def watch():
                while not done.wait(0.25):
                    mb = mem_available_mb()
                    if 0 <= mb < KILL_MB:
                        killed.append(mb)
                        try:
                            p.kill()
                        except OSError:
                            pass
                        return

            threading.Thread(target=watch, daemon=True).start()
            try:
                p.stdin.write((f"RUN {tool} {len(argv)}\n" + "".join(a + "\n" for a in argv)).encode())
                p.stdin.flush()
                head = p.stdout.readline().split()
                n = int(head[1])
                body = b""
                while len(body) < n:
                    chunk = p.stdout.read(n - len(body))
                    if not chunk:
                        raise OSError("short answer")
                    body += chunk
                tail = p.stdout.readline().split()
                code, ms = int(tail[1]), int(tail[2])
            except (OSError, ValueError, IndexError):
                done.set()
                self.p = None
                try:
                    p.kill()
                except OSError:
                    pass
                if killed:
                    log(f"warm JVM killed: MemAvailable {killed[0]} MB < {KILL_MB} MB")
                    return 4, f"mcx-buildd: stopped {tool}: MemAvailable {killed[0]} MB < {KILL_MB} MB (the warm JVM was killed to keep MetaCodex alive)", 0
                raise OSError("it ended during a request")
            done.set()
            self.calls += 1
            self.last = time.time()
            return code, body.decode("utf-8", "replace"), ms

    def status(self):
        p = self.p
        if p is None or p.poll() is not None:
            return {"running": False}
        rss = 0
        for line in read(f"/proc/{p.pid}/status").splitlines():
            if line.startswith("VmRSS:"):
                rss = int(line.split()[1]) // 1024
        return {"running": True, "pid": p.pid, "requests": self.calls, "idle_s": round(time.time() - self.last),
                "up_s": round(time.time() - self.started), "rss_mb": rss, "idle_stop_s": JVM_IDLE}


class Daemon:
    def __init__(self):
        self.dev = DevServer()
        self.budget = CpuBudget()
        self.lock = threading.Lock()
        self.turn = threading.Condition(self.lock)
        self.queue = []  # job ids waiting, in order
        self.running = None  # {"id", "args", "started", "pid"}
        self.last = None
        self.next_id = 1
        self.pin = []
        try:  # cores 0-2 when this process may use them (it does under the app's service process)
            if subprocess.run(["taskset", "-c", "0-2", "true"], capture_output=True).returncode == 0:
                self.pin = ["taskset", "-c", "0-2"]
        except OSError:
            pass
        self.jvm = JavaServer(self.pin)

    def status(self):
        with self.lock:
            run = dict(self.running) if self.running else None
            if run:
                run["seconds"] = round(time.time() - run["started"], 1)
            adj = app_adj(self.budget.app) if self.budget.app else None
            return {"pid": os.getpid(), "cpuset": read("/proc/self/cpuset").strip(), "cpus": cpus(),
                    "app_pid": self.budget.app, "app_adj": adj, "budget": self.budget.state,
                    "budget_paused_s": round(self.budget.paused_s), "cpu_last_5min_s": round(self.budget.used(time.time(), self.budget.samples[-1][1]) if self.budget.samples else 0.0, 1),
                    "pinned": bool(self.pin), "nice": NICE, "running": run, "queued": len(self.queue), "last": self.last,
                    "jvm": self.jvm.status()}

    def handle(self, conn):
        f = conn.makefile("rwb", buffering=0)

        def send(obj):
            f.write((json.dumps(obj) + "\n").encode())

        try:
            req = json.loads(f.readline().decode() or "{}")
        except (ValueError, OSError):
            return
        op = req.get("op", "run")
        if op == "status":
            send(self.status())
            return
        if op == "dev":
            if not self.dev.start():
                send({"ok": False, "error": self.dev.error})
                return
            try:
                m = self.dev.set(req["module"], req.get("package", "?"))
            except (OSError, KeyError) as e:
                send({"ok": False, "error": f"cannot read the module: {e}"})
                return
            send({"ok": True, "module": m})
            return
        if op == "dev-status":
            send(self.dev.status())
            return
        if op == "java":  # javac / D8 for a 2D panel build (mcx-build), outside the job queue: the job asking is running
            tool, argv = req.get("tool"), [str(a) for a in req.get("argv", [])]
            if tool not in ("javac", "d8") or any("\n" in a for a in argv):
                send({"op": "java", "unavailable": "bad request"})
                return
            try:
                code, out, ms = self.jvm.call(tool, argv)
            except OSError as e:
                send({"op": "java", "unavailable": str(e)})
                return
            send({"op": "java", "exit": code, "out": out, "ms": ms})
            return
        if op == "stop":
            send({"ok": True})
            os.kill(os.getpid(), signal.SIGTERM)
            return
        args = [str(a) for a in req.get("args", [])]
        cwd = req.get("cwd") or "/root"
        with self.lock:
            if len(self.queue) >= MAX_QUEUE:
                send({"line": f"mcx-buildd: {len(self.queue)} jobs are waiting already: try again later"})
                send({"exit": 5})
                return
            jid = self.next_id
            self.next_id += 1
            self.queue.append(jid)
            ahead = self.queue.index(jid) + (1 if self.running else 0)
        if ahead:
            send({"line": f"mcx-buildd: queued behind {ahead} job(s) (one build at a time keeps MetaCodex smooth)"})
        gone = threading.Event()

        def watch_client():  # the client closes the socket when it is stopped: cancel the job
            try:
                while conn.recv(64):
                    pass
            except OSError:
                pass
            gone.set()
            with self.lock:
                self.turn.notify_all()

        threading.Thread(target=watch_client, daemon=True).start()
        with self.lock:
            while self.queue[0] != jid or self.running is not None:
                if gone.is_set():
                    self.queue.remove(jid)
                    self.turn.notify_all()
                    return
                self.turn.wait(1.0)
            self.queue.pop(0)
            self.running = {"id": jid, "args": args, "started": time.time(), "pid": None}
        code, summary = 1, None
        budget_done = threading.Event()
        try:
            with open(BUSY, "w") as b:
                b.write(json.dumps({"id": jid, "args": args, "started": time.time()}))
            cmd = ["nice", "-n", str(NICE)] + self.pin + [mcx_build()] + args
            if "--json" not in args:
                cmd.append("--json")
            send({"line": f"mcx-buildd: job {jid} on cores {'0-2' if self.pin else cpus()} at nice {NICE}"})
            log(f"job {jid} start: {args} cwd {cwd}")
            env = dict(os.environ)
            env.setdefault("MCX_BUILD_JOBS", "2")
            env["MCX_BUILD_PAUSE_FILE"] = PAUSE
            p = subprocess.Popen(cmd, cwd=cwd if os.path.isdir(cwd) else "/root", stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                 env=env, start_new_session=True)
            with self.lock:
                self.running["pid"] = p.pid
            threading.Thread(target=self.budget.watch, args=(p.pid, budget_done, self.jvm.cpu), daemon=True).start()

            def killer():
                gone.wait()
                if p.poll() is None:
                    log(f"job {jid}: client gone, stopping it")
                    try:
                        os.killpg(p.pid, signal.SIGTERM)
                        time.sleep(2)
                        os.killpg(p.pid, signal.SIGKILL)
                    except OSError:
                        pass

            threading.Thread(target=killer, daemon=True).start()
            want_json = "--json" in args
            for raw in p.stdout:
                line = raw.decode("utf-8", "replace").rstrip("\n")
                if line.startswith("MCX-BUILD-JSON "):
                    try:
                        summary = json.loads(line[15:])
                    except ValueError:
                        pass
                    if not want_json:
                        continue
                if not gone.is_set():
                    try:
                        send({"line": line})
                    except OSError:
                        gone.set()
            code = p.wait()
            budget_done.set()
        except OSError as e:
            try:
                send({"line": f"mcx-buildd: {e}"})
            except OSError:
                pass
        finally:
            budget_done.set()
            try:
                os.remove(BUSY)
            except OSError:
                pass
            with self.lock:
                self.last = {"id": jid, "args": args, "exit": code, "seconds": round(time.time() - self.running["started"], 1),
                             "stages": (summary or {}).get("stages"), "result": (summary or {}).get("result")}
                self.running = None
                self.turn.notify_all()
            log(f"job {jid} end: exit {code} {self.last.get('result')}")
            gone.set()
        try:
            send({"exit": code})
        except OSError:
            pass

    def serve(self):
        os.makedirs(D, mode=0o700, exist_ok=True)
        os.chmod(D, 0o700)
        if os.path.exists(SOCK):
            if alive():
                print("mcx-buildd: already running", file=sys.stderr)
                return 0
            os.remove(SOCK)
        try:
            os.remove(BUSY)
        except OSError:
            pass
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.bind(SOCK)
        os.chmod(SOCK, 0o600)
        s.listen(8)
        with open(PIDF, "w") as f:
            f.write(str(os.getpid()))

        def bye(*_):
            self.jvm.stop("the daemon stops")
            for p in (SOCK, PIDF, BUSY):
                try:
                    os.remove(p)
                except OSError:
                    pass
            os._exit(0)

        signal.signal(signal.SIGTERM, bye)
        signal.signal(signal.SIGINT, bye)
        signal.signal(signal.SIGHUP, signal.SIG_IGN)
        def warm():  # glue object + precompiled headers, once per toolchain: the first build is warm too
            try:
                subprocess.run(["nice", "-n", "19"] + self.pin + [mcx_build(), "--warm"], stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL, timeout=600)
            except (OSError, subprocess.SubprocessError):
                pass

        threading.Thread(target=warm, daemon=True).start()
        log(f"serving on {SOCK}: pid {os.getpid()}, cpuset {read('/proc/self/cpuset').strip()}, cpus {cpus()}, pinned {bool(self.pin)}")
        while True:
            c, _ = s.accept()
            threading.Thread(target=self._conn, args=(c,), daemon=True).start()

    def _conn(self, c):
        try:
            self.handle(c)
        except Exception as e:  # one bad client never ends the daemon
            log(f"connection error: {e!r}")
        finally:
            try:
                c.close()
            except OSError:
                pass


def connect(timeout=3.0):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    s.connect(SOCK)
    s.settimeout(None)
    return s


def alive():
    try:
        s = connect(1.0)
        s.sendall(b'{"op":"status"}\n')
        ok = bool(s.makefile("rb").readline())
        s.close()
        return ok
    except OSError:
        return False


def ensure():
    if alive():
        return 0
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    out = open(LOG, "a")
    subprocess.Popen([sys.executable, "-I", os.path.realpath(__file__), "serve"], stdin=subprocess.DEVNULL, stdout=out,
                     stderr=out, start_new_session=True, close_fds=True)
    for _ in range(30):
        time.sleep(0.1)
        if alive():
            return 0
    print("mcx-buildd: did not start (see " + LOG + ")", file=sys.stderr)
    return 1


def client_json(req):
    try:
        s = connect()
    except OSError:
        print(json.dumps({"ok": False, "error": "no daemon (MQH starts it: mcx-buildd ensure)"}))
        return 100
    s.sendall((json.dumps(req) + "\n").encode())
    line = s.makefile("rb").readline()
    s.close()
    print(line.decode().strip())
    try:
        return 0 if json.loads(line).get("ok", True) else 1
    except ValueError:
        return 1


def client(op, args=None):
    try:
        s = connect()
    except OSError:
        if op == "status":
            print(json.dumps({"running": False, "error": "no daemon (MQH starts it: mcx-buildd ensure)"}))
        return 100
    f = s.makefile("rb")
    s.sendall((json.dumps({"op": op, "args": args or [], "cwd": os.getcwd()}) + "\n").encode())
    code = 0
    try:
        for raw in f:
            msg = json.loads(raw.decode())
            if op == "status" or op == "stop":
                print(json.dumps(msg, indent=1))
                break
            if "line" in msg:
                print(msg["line"], flush=True)
            if "exit" in msg:
                code = msg["exit"]
                break
        else:
            if op == "run":
                print("mcx-buildd: the daemon closed the connection", file=sys.stderr)
                code = 1
    except KeyboardInterrupt:
        code = 130
    finally:
        s.close()
    return code


def main(argv):
    cmd = argv[0] if argv else ""
    if cmd == "serve":
        return Daemon().serve()
    if cmd == "ensure":
        return ensure()
    if cmd in ("status", "stop"):
        return client(cmd)
    if cmd == "dev" and len(argv) >= 2:
        return client_json({"op": "dev", "module": os.path.abspath(argv[1]), "package": argv[2] if len(argv) > 2 else "?"})
    if cmd == "dev-status":
        return client_json({"op": "dev-status"})
    if cmd == "run":
        rest = argv[1:]
        if rest and rest[0] == "--":
            rest = rest[1:]
        # paths relative to the caller's folder: the daemon runs elsewhere
        rest = [os.path.abspath(a) if not a.startswith("-") and os.path.exists(a) else a for a in rest]
        return client("run", rest)
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
