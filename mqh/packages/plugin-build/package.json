{
  "name": "@bb/plugin-build",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "clean": "rimraf tsconfig.tsbuildinfo",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsrs --noEmit",
    "build": "node ../../scripts/build-node-entry.mjs src/cli.ts dist/cli.js --clean-dist"
  },
  "dependencies": {
    "@bb/domain": "workspace:*",
    "@bb/process-utils": "workspace:*",
    "@get-bb/plugin-sdk": "workspace:*",
    "es-module-lexer": "^2.3.2",
    "npm": "11.21.2",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@bb/tsconfig": "workspace:*",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.12"
  },
  "bin": {
    "bb-plugin-build": "./bin/bb-plugin-build.mjs"
  }
}
