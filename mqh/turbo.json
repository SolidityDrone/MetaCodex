// MQH: trimmed from upstream bb's turbo.json (tasks of removed apps/packages and of the web UI dropped;
// upstream comments were lost in the rewrite, see bb at the commit in UPSTREAM.md for them).
{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "MQH_BUILD_TOOLCHAIN"
  ],
  "globalPassThroughEnv": [
    "npm_config_store_dir",
    "pnpm_config_store_dir",
    "PSModuleAnalysisCachePath"
  ],
  "tasks": {
    "@bb/server#validate:marketplace": {
      "dependsOn": [
        "topo"
      ],
      "cache": false
    },
    "@bb/db#db:generate": {
      "cache": false
    },
    "build": {
      "dependsOn": [
        "topo"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/packages/tsconfig/*.json",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/scripts/build-node-entry.mjs",
        "$TURBO_ROOT$/scripts/build-package.mjs",
        "$TURBO_ROOT$/scripts/build-utils.mjs",
        "$TURBO_ROOT$/packages/plugin-build/src/zod-locale-stub.mjs",
        "$TURBO_ROOT$/scripts/precompress-app-dist.mjs",
        "$TURBO_ROOT$/turbo.json"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@bb/sdk#test": {
      "env": [
        "VITEST_MAX_WORKERS"
      ],
      "dependsOn": [
        "//#ensure-native-modules",
        "topo"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/*/package.json",
        "$TURBO_ROOT$/apps/*/scripts/**",
        "$TURBO_ROOT$/apps/*/src/**",
        "$TURBO_ROOT$/apps/*/tsconfig.json",
        "$TURBO_ROOT$/apps/*/vite.config.ts",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/packages/*/scripts/**",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/packages/*/tsconfig.json",
        "$TURBO_ROOT$/packages/db/drizzle/**",
        "$TURBO_ROOT$/packages/tsconfig/*.json",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/scripts/*.mjs",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/vitest*.ts"
      ]
    },
    "@bb/server#build": {
      "dependsOn": [
        "topo"
      ],
      "outputs": [
        "dist/**"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/plugins/bb-guide/skills/**",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/packages/tsconfig/*.json",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/scripts/build-node-entry.mjs",
        "$TURBO_ROOT$/scripts/build-package.mjs",
        "$TURBO_ROOT$/scripts/build-utils.mjs",
        "$TURBO_ROOT$/packages/plugin-build/src/zod-locale-stub.mjs",
        "$TURBO_ROOT$/turbo.json"
      ]
    },
    "@bb/plugin-build#build": {
      "dependsOn": [
        "topo"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/build-utils.mjs",
        "$TURBO_ROOT$/packages/plugin-build/src/zod-locale-stub.mjs",
        "$TURBO_ROOT$/scripts/build-node-entry.mjs",
        "$TURBO_ROOT$/packages/bb-app/package.json"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "prepare:bundled": {
      "dependsOn": [
        "topo",
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!dist/**",
        "!.bundled-runtime/**"
      ],
      "outputs": [
        ".bundled-runtime/**"
      ]
    },
    "@bb/bundled-plugins#build": {
      "dependsOn": [
        "^prepare:bundled",
        "@bb/server#generate:bb-official-marketplace"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/server/src/services/plugins/builtin-registry.ts",
        "$TURBO_ROOT$/apps/server/src/services/plugin-catalog/bundled-marketplace-paths.ts"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "bb-app#build": {
      "dependsOn": [
        "@bb/server#build",
        "@bb/bundled-plugins#build",
        "@bb/host-daemon#build",
        "@bb/cli#build",
        "@bb/sdk#build",
        "@get-bb/plugin-sdk#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/bb-app/package.json",
        "$TURBO_ROOT$/packages/bb-app/scripts/**",
        "$TURBO_ROOT$/packages/bb-app/src/**",
        "$TURBO_ROOT$/packages/bb-app/tsconfig.json",
        "$TURBO_ROOT$/packages/sdk/package.json",
        "$TURBO_ROOT$/packages/sdk/src/**",
        "$TURBO_ROOT$/packages/sdk/tsconfig.json",
        "$TURBO_ROOT$/packages/tsconfig/*.json",
        "$TURBO_ROOT$/scripts/*.mjs"
      ],
      "outputs": [
        "app/**",
        "dist/**",
        "host-daemon/**",
        "server/**"
      ]
    },
    "bb-app#build:host": {
      "dependsOn": [
        "@bb/host-daemon#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/host-daemon/dist/**",
        "$TURBO_ROOT$/packages/bb-app/package.json",
        "$TURBO_ROOT$/packages/bb-app/scripts/build-host.mjs",
        "$TURBO_ROOT$/packages/bb-app/src/**",
        "$TURBO_ROOT$/packages/bb-app/tsconfig.json",
        "$TURBO_ROOT$/packages/config/package.json",
        "$TURBO_ROOT$/packages/config/src/**",
        "$TURBO_ROOT$/packages/config/tsconfig.json",
        "$TURBO_ROOT$/packages/tsconfig/*.json",
        "$TURBO_ROOT$/scripts/build-utils.mjs",
        "$TURBO_ROOT$/packages/plugin-build/src/zod-locale-stub.mjs"
      ],
      "outputs": [
        "host-package/**"
      ]
    },
    "bb-plugin-tasks#build": {
      "dependsOn": [
        "topo",
        "@get-bb/plugin-sdk#build"
      ]
    },
    "storybook": {
      "dependsOn": [
        "@bb/templates#generate:templates"
      ],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "*"
      ]
    },
    "@bb/host-daemon#dev": {
      "dependsOn": [
        "@bb/cli#build",
        "@bb/templates#generate:templates"
      ],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "*"
      ]
    },
    "@bb/server#dev": {
      "dependsOn": [
        "@bb/server#generate:bb-official-marketplace",
        "@bb/templates#generate:templates",
        "@get-bb/plugin-sdk#build:runtime"
      ],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "*"
      ]
    },
    "clean": {
      "cache": false
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.oxlintrc.json",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/scripts/forkable-plugins.json",
        "$TURBO_ROOT$/scripts/oxlint-plugin.mjs"
      ]
    },
    "//#ensure-native-modules": {
      "cache": false,
      "inputs": [
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/packages/db/package.json",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/scripts/ensure-native-modules.mjs"
      ],
      "outputs": []
    },
    "topo": {
      "dependsOn": [
        "^topo"
      ]
    },
    "@bb/templates#topo": {
      "dependsOn": [
        "^topo",
        "@bb/templates#generate:templates"
      ]
    },
    "@bb/process-utils#topo": {
      "dependsOn": [
        "^topo",
        "@bb/process-utils#generate:profile-worker"
      ]
    },
    "@bb/process-utils#generate:profile-worker": {
      "dependsOn": [],
      "inputs": [
        "src/profile-worker.ts",
        "src/stall-attribution.ts",
        "src/stall-windows.ts",
        "src/event-loop-delay.ts",
        "scripts/generate-profile-worker.mjs",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/pnpm-lock.yaml"
      ],
      "outputs": [
        "src/generated/profile-worker.ts"
      ]
    },
    "@bb/server#topo": {
      "dependsOn": [
        "^topo",
        "@bb/server#generate:bb-official-marketplace"
      ]
    },
    "@bb/server#generate:bb-official-marketplace": {
      "dependsOn": [],
      "inputs": [
        "scripts/generate-bb-official-marketplace.ts",
        "src/services/plugin-catalog/bundled-marketplace-paths.ts",
        "src/services/plugins/builtin-registry.ts",
        "$TURBO_ROOT$/packages/domain/src/plugin-catalog-category.ts",
        "$TURBO_ROOT$/packages/domain/src/plugin-id.ts",
        "$TURBO_ROOT$/packages/domain/src/plugin-manifest.ts",
        "$TURBO_ROOT$/plugins/*/package.json",
        "$TURBO_ROOT$/plugins/*/PLUGIN_OVERVIEW.md",
        "$TURBO_ROOT$/plugins/bb-official.json"
      ],
      "outputs": [
        "src/generated/bb-official-marketplace/marketplace.json"
      ]
    },
    "@bb/templates#generate:templates": {
      "dependsOn": [],
      "inputs": [
        "scripts/generate-templates.mjs",
        "scripts/write-generated.mjs",
        "src/templates/**"
      ],
      "outputs": [
        "src/generated/templates.generated.ts"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "topo"
      ]
    },
    "@bb/host-daemon#build": {
      "dependsOn": [
        "topo"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/packages/tsconfig/*.json",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/scripts/build-node-entry.mjs",
        "$TURBO_ROOT$/scripts/build-package.mjs",
        "$TURBO_ROOT$/scripts/build-utils.mjs",
        "$TURBO_ROOT$/packages/plugin-build/src/zod-locale-stub.mjs",
        "$TURBO_ROOT$/scripts/precompress-app-dist.mjs",
        "$TURBO_ROOT$/turbo.json"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@bb/cli#test": {
      "env": [
        "VITEST_MAX_WORKERS"
      ],
      "dependsOn": [
        "//#ensure-native-modules",
        "topo"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/plugins/bb-guide/skills/bb-cli/**",
        "$TURBO_ROOT$/vitest*.ts"
      ]
    },
    "@bb/scripts#test": {
      "env": [
        "VITEST_MAX_WORKERS"
      ],
      "dependsOn": [
        "//#ensure-native-modules",
        "@bb/cli#build",
        "topo"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.github/actions/setup-workspace/**",
        "$TURBO_ROOT$/.github/actions/setup-workspace-tools/**",
        "$TURBO_ROOT$/.github/actions/install-appimage-fuse/**",
        "$TURBO_ROOT$/.github/actions/cache-workspace/**",
        "$TURBO_ROOT$/.github/workflows/ci.yml",
        "$TURBO_ROOT$/.github/workflows/ci-cache-maintenance.yml",
        "$TURBO_ROOT$/scripts/lib/**",
        "$TURBO_ROOT$/scripts/forkable-plugins.json",
        "$TURBO_ROOT$/.github/APPROVED_CONTRIBUTORS",
        "$TURBO_ROOT$/.github/workflows/approve-contributor.yml",
        "$TURBO_ROOT$/.github/workflows/pr-gate.yml",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/scripts/*.mjs",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/plugins/*/package.json",
        "$TURBO_ROOT$/packages/bundled-plugins/package.json",
        "$TURBO_ROOT$/apps/server/src/services/plugins/builtin-registry.ts",
        "$TURBO_ROOT$/vitest*.ts"
      ]
    },
    "@bb/provider-bridge-protocol#test": {
      "env": [
        "VITEST_MAX_WORKERS"
      ],
      "dependsOn": [
        "//#ensure-native-modules",
        "topo"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest*.ts",
        "$TURBO_ROOT$/plugins/provider-codex/src/**",
        "$TURBO_ROOT$/plugins/provider-codex/package.json",
        "$TURBO_ROOT$/plugins/provider-claude-code/src/**",
        "$TURBO_ROOT$/plugins/provider-claude-code/package.json",
        "$TURBO_ROOT$/packages/plugin-sdk/src/**"
      ]
    },
    "test": {
      "env": [
        "VITEST_MAX_WORKERS"
      ],
      "dependsOn": [
        "//#ensure-native-modules",
        "topo"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest*.ts"
      ],
      "passThroughEnv": [
        "UPDATE_PARITY_ROW_COUNTS",
        "UPDATE_TRANSCRIPT_EXPECTATIONS"
      ]
    },
    "@bb/templates#test": {
      "env": [
        "VITEST_MAX_WORKERS"
      ],
      "dependsOn": [
        "//#ensure-native-modules",
        "@get-bb/plugin-sdk#build",
        "@get-bb/plugin-sdk#build:types",
        "topo"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest*.ts"
      ]
    },
    "@bb/server#test": {
      "env": [
        "MQH_CI_TEST_SHARD",
        "VITEST_MAX_WORKERS"
      ],
      "dependsOn": [
        "@bb/agent-runtime#generate:test-bridges",
        "//#ensure-native-modules",
        "@get-bb/plugin-sdk#build",
        "@get-bb/plugin-sdk#build:types",
        "topo"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/plugins/*/**",
        "!$TURBO_ROOT$/plugins/*/node_modules/**",
        "!$TURBO_ROOT$/plugins/*/dist/**",
        "$TURBO_ROOT$/tests/scripted-echo-provider/host.ts",
        "$TURBO_ROOT$/tests/scripted-echo-provider/src/**",
        "$TURBO_ROOT$/examples/plugins/echo-provider/*.ts",
        "$TURBO_ROOT$/examples/plugins/echo-provider/package.json",
        "$TURBO_ROOT$/examples/plugins/echo-provider/src/**",
        "$TURBO_ROOT$/vitest*.ts"
      ]
    },
    "@bb/host-daemon#test": {
      "env": [
        "VITEST_MAX_WORKERS"
      ],
      "dependsOn": [
        "//#ensure-native-modules",
        "@get-bb/plugin-sdk#build",
        "topo"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tests/scripted-echo-provider/host.ts",
        "$TURBO_ROOT$/tests/scripted-echo-provider/src/**",
        "$TURBO_ROOT$/vitest*.ts"
      ]
    },
    "bench": {
      "dependsOn": [
        "//#ensure-native-modules",
        "topo"
      ],
      "cache": false,
      "passThroughEnv": [
        "MQH_SIDEBAR_BENCH_OUT",
        "MQH_SIDEBAR_BENCH_THREADS",
        "MQH_WATCHER_BENCHMARK_OUTPUT",
        "PROMPTBOX_PERF_FIXTURE_OUT"
      ]
    },
    "@bb/server#test:provider-corpus": {
      "dependsOn": [
        "//#ensure-native-modules",
        "topo"
      ],
      "cache": false,
      "passThroughEnv": [
        "MQH_PROVIDER_CORPUS_DIR",
        "MQH_PROVIDER_CORPUS_SNAPSHOT",
        "MQH_PROVIDER_CORPUS_SNAPSHOT_DIR",
        "MQH_PROVIDER_CORPUS_ALLOWLIST",
        "MQH_PROVIDER_CORPUS_ROW_CLASSES"
      ]
    },
    "@bb/plugin-build#test": {
      "env": [
        "VITEST_MAX_WORKERS"
      ],
      "dependsOn": [
        "//#ensure-native-modules",
        "@get-bb/plugin-sdk#build",
        "@get-bb/plugin-sdk#build:types",
        "topo"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/vitest*.ts",
        "$TURBO_ROOT$/plugins/*/icons/**",
        "$TURBO_ROOT$/examples/plugins/*/icons/**",
        "$TURBO_ROOT$/plugins/keep-awake/**",
        "$TURBO_ROOT$/plugins/provider-acp/**",
        "$TURBO_ROOT$/plugins/provider-claude-code/**",
        "$TURBO_ROOT$/plugins/provider-codex/**",
        "$TURBO_ROOT$/plugins/provider-pi/**",
        "$TURBO_ROOT$/plugins/environment-git-worktree/**",
        "$TURBO_ROOT$/plugins/environment-modal-sandbox/**",
        "$TURBO_ROOT$/plugins/environment-personal-workspace/**",
        "$TURBO_ROOT$/plugins/environment-project-checkout/**",
        "!$TURBO_ROOT$/plugins/*/node_modules/**",
        "!$TURBO_ROOT$/plugins/*/dist/**",
        "!$TURBO_ROOT$/plugins/*/.bundled-runtime/**",
        "$TURBO_ROOT$/packages/environment-provider-host/package.json",
        "$TURBO_ROOT$/packages/environment-provider-host/src/**"
      ]
    },
    "@bb/agent-runtime#generate:test-bridges": {
      "dependsOn": [
        "topo"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/domain/src/**",
        "$TURBO_ROOT$/packages/plugin-sdk/src/**",
        "$TURBO_ROOT$/packages/provider-bridge-protocol/src/**",
        "$TURBO_ROOT$/scripts/build-utils.mjs",
        "$TURBO_ROOT$/packages/plugin-build/src/zod-locale-stub.mjs",
        "$TURBO_ROOT$/tests/scripted-echo-provider/src/**"
      ],
      "outputs": [
        "dist/test-bridges/**"
      ]
    },
    "@bb/agent-runtime#test": {
      "env": [
        "VITEST_MAX_WORKERS"
      ],
      "dependsOn": [
        "//#ensure-native-modules",
        "@bb/agent-runtime#generate:test-bridges",
        "topo"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/plugins/provider-codex/**",
        "!$TURBO_ROOT$/plugins/*/node_modules/**",
        "!$TURBO_ROOT$/plugins/*/dist/**",
        "!$TURBO_ROOT$/plugins/*/.bundled-runtime/**",
        "$TURBO_ROOT$/tests/scripted-echo-provider/src/**",
        "$TURBO_ROOT$/vitest*.ts"
      ]
    },
    "@bb/agent-runtime#test:integration": {
      "dependsOn": [
        "//#ensure-native-modules",
        "@get-bb/plugin-sdk#build",
        "topo"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/plugins/provider-acp/**",
        "$TURBO_ROOT$/plugins/provider-claude-code/**",
        "$TURBO_ROOT$/plugins/provider-codex/**",
        "$TURBO_ROOT$/plugins/provider-pi/**",
        "!$TURBO_ROOT$/plugins/*/node_modules/**",
        "!$TURBO_ROOT$/plugins/*/dist/**",
        "!$TURBO_ROOT$/plugins/*/.bundled-runtime/**",
        "$TURBO_ROOT$/vitest*.ts"
      ],
      "passThroughEnv": [
        "CLAUDE_CODE_OAUTH_TOKEN",
        "MQH_CLAUDE_CODE_EXECUTABLE"
      ]
    },
    "smoke:tarball": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "passThroughEnv": [
        "npm_config_cache"
      ],
      "outputs": []
    },
    "smoke:boot": {
      "dependsOn": [
        "build",
        "//#ensure-native-modules"
      ],
      "cache": false,
      "outputs": []
    },
    "test:integration": {
      "dependsOn": [
        "//#ensure-native-modules",
        "topo"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest*.ts"
      ],
      "passThroughEnv": [
        "CLAUDE_CODE_OAUTH_TOKEN",
        "MQH_CLAUDE_CODE_EXECUTABLE"
      ]
    },
    "@get-bb/plugin-sdk#build:types": {
      "dependsOn": [
        "topo"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/build-utils.mjs",
        "$TURBO_ROOT$/packages/plugin-build/src/zod-locale-stub.mjs"
      ],
      "outputs": [
        "bundled-types/**"
      ]
    },
    "@get-bb/plugin-sdk#build": {
      "dependsOn": [
        "topo"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/build-utils.mjs",
        "$TURBO_ROOT$/packages/plugin-build/src/zod-locale-stub.mjs"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@get-bb/plugin-sdk#typecheck": {
      "dependsOn": [
        "@get-bb/plugin-sdk#build:types",
        "topo"
      ]
    },
    "@get-bb/plugin-sdk#test": {
      "env": [
        "VITEST_MAX_WORKERS"
      ],
      "dependsOn": [
        "//#ensure-native-modules",
        "@get-bb/plugin-sdk#build:types",
        "topo"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest*.ts"
      ]
    },
    "@get-bb/plugin-sdk#build:runtime": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/build-utils.mjs",
        "$TURBO_ROOT$/packages/plugin-build/src/zod-locale-stub.mjs"
      ],
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "topo"
      ]
    },
    "bb-plugin-bb--storage-retention#typecheck": {
      "dependsOn": [
        "@get-bb/plugin-sdk#build:types",
        "topo"
      ],
      "inputs": [
        "$TURBO_DEFAULT$"
      ]
    },
    "bb-plugin-ask-user-question#typecheck": {
      "dependsOn": [
        "@get-bb/plugin-sdk#build:types",
        "topo"
      ],
      "inputs": [
        "$TURBO_DEFAULT$"
      ]
    },
    "bb-plugin-ask-user-question#test": {
      "env": [
