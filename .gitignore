# MetaCodex monorepo (Unity-specific rules live in unity/.gitignore)
.DS_Store
Thumbs.db
__pycache__/
*.pyc
node_modules/
/native/pty/out/
# harness builds (mqh/)
/mqh/**/dist/
/mqh/**/.turbo/

# personal status log (owner request: not versioned)
/STATUS_LOG.md

# native apps: build outputs and the local debug signing key (native/hello-native/build.sh makes both)
/native/*/build/
/native/.debug.keystore

# README diagrams: the WebP files ship; the PNGs are render outputs (docs/diagrams/render.sh)
docs/assets/diagrams/*.png
