<?xml version="1.0" encoding="utf-8" standalone="no"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:installLocation="auto" xmlns:horizonos="http://schemas.horizonos/sdk">
  <uses-feature android:name="com.oculus.feature.BOUNDARYLESS_APP" android:required="true" />
  <queries>
    <package android:name="com.oculus.vrshell" />
    <!-- apps built in MetaCodex's Linux: launched by package name after they are installed -->
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>
  <application android:label="@string/app_name" android:icon="@mipmap/app_icon" android:allowBackup="false">
    <activity android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" android:configChanges="locale|fontScale|keyboard|keyboardHidden|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode" android:launchMode="singleTask" android:name="com.unity3d.player.UnityPlayerActivity" android:excludeFromRecents="true" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
        <category android:name="com.oculus.intent.category.VR" />
      </intent-filter>
      <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />
    </activity>
    <!-- the local AI service runs in its own process: Android places it on cores 0-2, away from the immersive
         app's cores 3-5 (docs/voice.md) -->
    <!-- a foreground service while it runs MQH, the agents and the local AI, so they go on while another app (one the
         user just built) is in front; a partial wake lock only while a native app build runs -->
    <service android:name="com.pnncl.metacodex.ai.MetaCodexAiService" android:process=":ai" android:exported="false" android:foregroundServiceType="specialUse">
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Local agent runtime: the user's coding agents, a local speech and language model service and native app builds keep running while the user tries an app they built" />
    </service>
    <meta-data android:name="unityplayer.SkipPermissionsDialog" android:value="false" />
    <meta-data android:name="com.oculus.handtracking.frequency" android:value="LOW" />
    <meta-data android:name="com.oculus.ossplash.background" android:value="black" />
    <meta-data android:name="com.oculus.trade_cpu_for_gpu_amount" android:value="-1" />
    <meta-data android:name="com.oculus.telemetry.project_guid" android:value="6835c1e9-f2e1-4412-9e03-da6580345280" />
    <meta-data android:name="com.oculus.supportedDevices" android:value="quest2|questpro|quest3|quest3s" tools:replace="android:value" />
  </application>
  <uses-feature android:name="android.hardware.vr.headtracking" android:version="1" android:required="true" />
  <uses-feature android:name="oculus.software.handtracking" android:required="false" />
  <uses-permission android:name="com.oculus.permission.HAND_TRACKING" />
  <!-- voice control: push-to-talk speech-to-text (local AI service, docs/voice.md) -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <!-- Ambient Focus: the live depth of the room ("spatial data", no Space Setup scan) and, for its blur, the passthrough camera -->
  <uses-permission android:name="com.oculus.permission.USE_SCENE" />
  <uses-permission android:name="horizonos.permission.HEADSET_CAMERA" />
  <uses-feature android:name="oculus.software.overlay_keyboard" android:required="false" />
  <uses-feature android:name="com.oculus.feature.PASSTHROUGH" android:required="true" />
  <horizonos:uses-horizonos-sdk horizonos:minSdkVersion="60" horizonos:targetSdkVersion="205" />
  <uses-permission android:name="com.oculus.permission.USE_ANCHOR_API" />
  <!-- native apps built in the Linux userland: installed with Android's own installer, the user confirms each one
       (MetaCodexInstaller.java; the user allows "install unknown apps" for MetaCodex once) -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <!-- updates of apps MetaCodex installed itself go through without a new confirmation when Android allows it -->
  <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
  <!-- the AI service process stays in the foreground while it runs MQH / the local AI (MetaCodexAiService.java) -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <!-- held only while a native app build runs, so it completes with the headset off -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />
</manifest>
