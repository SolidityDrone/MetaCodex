<?xml version="1.0" encoding="utf-8"?>
<!-- The app's network security config (OVRProjectConfig.securityXmlPath, set in MetaCodexSetup). Plain http is refused
     everywhere, as in the XR SDK's default, except for this headset's own servers on the loopback address: the code
     editor, a dev server the user runs in the Linux, MQH and the local AI service are all http on 127.0.0.1. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
