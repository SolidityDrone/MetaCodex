#!/usr/bin/env python3
"""Drive the MetaCodex terminal on the headset (or Editor) through its control port.

Usage:
  Tools/qterm screen | status | log [n] | restart | recenter
  Tools/qterm text 'ls -la\\n'        type text (\\n = Enter, \\e = Esc, \\xHH)
  Tools/qterm key enter|tab|up|...    a TermKey name
  Tools/qterm press ctrl|esc|...      a key-bar button
  Tools/qterm run 'uname -a' [secs]   type a command + Enter, wait until the screen is still, print it
Options: --local (Editor on this PC, no adb), --serial <id>, --port <n>
Needs adb on PATH (the skill set's bin/adb shim) unless --local.
"""
import os, socket, subprocess, sys, time

PKG = "com.pnncl.metacodex"
args = sys.argv[1:]
local = "--local" in args
port, serial = 47800, None
if "--port" in args:
    i = args.index("--port"); port = int(args[i + 1]); del args[i:i + 2]
if "--serial" in args:
    i = args.index("--serial"); serial = args[i + 1]; del args[i:i + 2]
args = [a for a in args if a != "--local"]
if not args:
    print(__doc__); sys.exit(2)


def adb(*a):
    cmd = ["adb"] + (["-s", serial] if serial else []) + list(a)
    return subprocess.run(cmd, capture_output=True, text=True, timeout=30).stdout.replace("\r", "").strip()


def token():
    if local:
        win_user = os.environ.get("WIN_USER", "pnncl")
        p = f"/mnt/c/Users/{win_user}/AppData/LocalLow/pnncl/MetaCodex/control.token"
        return open(p).read().strip()
    fwd = adb("forward", "--list")
    if f"tcp:{port} tcp:{port}" not in fwd:
        adb("forward", f"tcp:{port}", f"tcp:{port}")
    t = adb("shell", "cat", f"/sdcard/Android/data/{PKG}/files/control.token")
    if not t or "No such file" in t:
        sys.exit("no control.token on the device: is the app running?")
    return t


class Port:
    def __init__(self):
        self.s = socket.create_connection(("127.0.0.1", port), timeout=15)
        self.f = self.s.makefile("rw", encoding="utf-8", newline="\n")
        r = self.call("auth " + token())
        if r.strip() != "ok":
            sys.exit("auth failed: " + r)

    def call(self, line):
        self.f.write(line + "\n"); self.f.flush()
        out = []
        for l in self.f:
            l = l.rstrip("\n")
            if l == ".":
                break
            out.append(l)
        return "\n".join(out)


p = Port()
cmd, rest = args[0], " ".join(args[1:])
if cmd == "run":
    wait = 60.0
    parts = args[1:]
    if len(parts) > 1 and parts[-1].replace(".", "", 1).isdigit():
        wait = float(parts[-1]); parts = parts[:-1]
    p.call("text " + " ".join(parts) + "\\n")
    last, still, t0 = None, 0.0, time.time()
    while time.time() - t0 < wait:
        time.sleep(0.5)
        s = p.call("screen")
        if s == last:
            still += 0.5
            if still >= 2.0:
                break
        else:
            still, last = 0.0, s
    print(last if last is not None else p.call("screen"))
else:
    print(p.call(cmd + (" " + rest if rest else "")))
